{
  "name": "menu_display_2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://exquisite-menus-2.thefrenchartist.dev/",
  "scripts": {
    "dev": "concurrently -n worker,web -c cyan,magenta \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --config ../wrangler.jsonc --port 8787",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:worker": "wrangler deploy --config ../wrangler.jsonc",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.1.3",
    "@heroicons/react": "^2.1.5",
    "@tailwindcss/typography": "^0.5.15",
    "gh-pages": "^6.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.1",
    "react-zoom-pan-pinch": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.1",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  }
}
